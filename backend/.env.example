# Puerto del servidor
PORT=3000

# Conexión Base de Datos Turso (En producción con Render + Turso)
# E.g.: libsql://tu-base-datos.turso.io
DATABASE_URL=file:./local.db
TURSO_AUTH_TOKEN=tu_turso_auth_token_aqui

# Seguridad JWT
JWT_SECRET=tu_clave_secreta_jwt_muy_segura
JWT_REFRESH_SECRET=tu_clave_secreta_refresh_jwt

# Mercado Pago (Opcional para cobros)
MERCADOPAGO_ACCESS_TOKEN=tu_mercadopago_access_token

# URL de la aplicación Frontend
APP_URL=http://localhost:5173
